# ── Required ─────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk authentication (https://dashboard.clerk.com → your app → API keys)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Frontend reads this one at build time (must exist when running pnpm build)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Optional (reserved, no code reads these yet) ─────────────────────
# APP_URL=https://practice.mathpivot.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Runtime ──────────────────────────────────────────────────────────
# Port the production server listens on (default 3000)
# PORT=3000
